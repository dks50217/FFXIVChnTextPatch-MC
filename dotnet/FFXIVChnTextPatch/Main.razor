@inject PatchService Patcher
@inject Func<string?> PickFolder

<div class="window">
@if (_showConfig)
{
    <h1>漢化設置</h1>
    <div class="form">
        <label>遊戲路徑</label>
        <div class="row">
            <input value="@_gamePath" readonly />
            <button class="small" @onclick="Browse">瀏覽…</button>
        </div>

        <label>檔案語言</label>
        <div class="row"><span class="fixed-value">CSV（resource/rawexd）</span></div>

        <label>原始語言</label>
        <div class="row">
            <select @bind="_sLang">
                <option value="JA">日文</option>
                <option value="EN">英文</option>
                <option value="DE">德文</option>
                <option value="FR">法文</option>
                <option value="CHS">簡體中文</option>
            </select>
        </div>

        <div class="row checks">
            <label><input type="checkbox" @bind="_replaceFont" /> 替換字體</label>
            <label><input type="checkbox" @bind="_replaceText" /> 替換文本</label>
        </div>

        @if (_replaceFont && !ResourceBootstrap.HasFont())
        {
            <div class="hint">找不到字體檔（resource/font）。字體檔較大未隨 exe 附帶，需替換字體請自行到
                <b>@ResourceBootstrap.RepoUrl</b> 下載後放入 resource/font。</div>
        }

        <details class="skip">
            <summary>跳過的資料表（已勾選 @_skip.Count 項）</summary>
            <input class="skip-search" placeholder="搜尋表名或說明…" @bind="_skipFilter" @bind:event="oninput" />
            <div class="skip-list">
                @foreach (var entry in _skipEntries.Where(MatchesSkipFilter))
                {
                    <label>
                        <input type="checkbox" checked="@_skip.Contains(entry.Key)"
                               @onchange="e => ToggleSkip(entry.Key, (bool)e.Value!)" />
                        <span class="name">@entry.Display</span>
                        <span class="desc">@entry.Desc</span>
                    </label>
                }
            </div>
        </details>

        @if (_message != null)
        {
            <p class="message error">@_message</p>
        }

        <div class="row buttons">
            <button class="primary" @onclick="SaveConfig">確認</button>
            <button @onclick="CancelConfig" disabled="@(!PatchService.IsFFXIVFolder(Config.Get("GamePath")))">返回</button>
        </div>
    </div>
}
else
{
    <h1>PatchTool</h1>
    <div class="path" title="@Config.Get("GamePath")">@Config.Get("GamePath")</div>
    <div class="status @(Status.Warn ? "warn" : "")">@Status.Text</div>

    <div class="actions">
        <button class="big primary" disabled="@(_busy || _pending != null)" @onclick='() => AskConfirm("漢化", Patch)'>漢化</button>
        <button class="big" disabled="@(_busy || _pending != null)" @onclick='() => AskConfirm("還原", Rollback)'>還原</button>
        <button class="big" disabled="@(_busy || _pending != null)" @onclick="() => { _message = null; _showConfig = true; }">設置</button>
    </div>


    <div class="toolbar">
        <button class="small" disabled="@_busy" @onclick="Lint">檢查翻譯 CSV</button>
        <button class="small" disabled="@_busy" @onclick="UpdateRawexd" title="下載 Souma 上游翻譯 → 簡轉繁 → 合併（本地已有的翻譯不會被覆蓋）">更新翻譯 CSV</button>
    </div>

    @if (_busy)
    {
        <div class="progress-area">
            <progress max="1" value="@_percent"></progress>
            <div class="progress-text">@_action@_detail（@((_percent * 100).ToString("0"))%）</div>
        </div>
    }
    @if (_message != null)
    {
        <p class="message @(_isError ? "error" : "ok")">@_message</p>
    }
}

@if (_showResourcePrompt)
{
    <div class="modal-backdrop">
        <div class="modal">
            <div class="modal-title">缺少翻譯檔</div>
            @if (_downloadingRes)
            {
                <div class="modal-note">@_action@_detail（@((_percent * 100).ToString("0"))%）</div>
                <progress max="1" value="@_percent"></progress>
            }
            else
            {
                <div class="modal-note">
                    偵測不到翻譯 CSV（resource/rawexd）。是否從 GitHub 下載最新翻譯檔？<br />
                    字體檔太大不含在內，需替換字體請自行到 <b>@ResourceBootstrap.RepoUrl</b> 下載。
                </div>
                <div class="modal-buttons">
                    <button @onclick="() => _showResourcePrompt = false">稍後</button>
                    <button class="primary" @onclick="DownloadResources">下載</button>
                </div>
            }
        </div>
    </div>
}

@if (_pending is { } pend)
{
    <div class="modal-backdrop" @onclick="() => _pending = null">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-title">確定要@(pend.Label)嗎？</div>
            @if (pend.Note.Length > 0)
            {
                <div class="modal-note">@pend.Note</div>
            }
            <div class="modal-buttons">
                <button @onclick="() => _pending = null">取消</button>
                <button class="primary" @onclick="ConfirmPending">確定</button>
            </div>
        </div>
    </div>
}
</div>

@code {
    private static (string Text, bool Warn) Status => PatchService.PatchStatus();

    private bool _showConfig;
    private bool _busy;
    private bool _showResourcePrompt;
    private bool _downloadingRes;
    private (string Label, string Note, Func<Task> Run)? _pending;
    private double _percent;
    private string _action = "";
    private string _detail = "";
    private string? _message;
    private bool _isError;

    // config 表單狀態
    private string _gamePath = "";
    private string _sLang = "JA";
    private bool _replaceFont;
    private bool _replaceText = true;

    // 跳過清單：Key 是寫進 SkipFiles 的值（exd/小寫表名，資料夾為前綴匹配）
    private record SkipEntry(string Key, string Display, string? Desc);
    private List<SkipEntry> _skipEntries = new();
    private HashSet<string> _skip = new();
    private string _skipFilter = "";

    protected override void OnInitialized()
    {
        _showConfig = !PatchService.IsFFXIVFolder(Config.Get("GamePath"));
        _showResourcePrompt = ResourceBootstrap.NeedsCsv();
        LoadConfigForm();
    }

    private async Task DownloadResources()
    {
        _downloadingRes = true;
        _percent = 0;
        _action = "準備下載……";
        _detail = "";
        var progress = new Progress<PatchProgress>(p =>
        {
            _percent = p.Percent;
            _action = p.Action;
            _detail = p.Detail;
            InvokeAsync(StateHasChanged);
        });
        var (ok, message) = await ResourceBootstrap.DownloadAsync(progress);
        _downloadingRes = false;
        _showResourcePrompt = false;
        _isError = !ok;
        _message = message;
        if (ok) _skipEntries = BuildSkipEntries(); // rawexd 現在有檔了，重建跳過清單
        StateHasChanged();
    }

    private void LoadConfigForm()
    {
        _gamePath = Config.Get("GamePath") ?? "";
        _sLang = Config.Get("SLanguage") ?? "JA";
        _replaceFont = Config.Get("ReplaFont") == "1";
        _replaceText = Config.Get("ReplaText") != "0";
        _skip = (Config.Get("SkipFiles") ?? "")
            .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => s.ToLowerInvariant())
            .ToHashSet();
        if (_skipEntries.Count == 0) _skipEntries = BuildSkipEntries();
    }

    /// <summary>rawexd 頂層 CSV 各一項，子資料夾各一項（跳過整個資料夾）。</summary>
    private static List<SkipEntry> BuildSkipEntries()
    {
        var list = new List<SkipEntry>();
        string rawexd = AppEnv.P("resource", "rawexd");
        if (!Directory.Exists(rawexd)) return list;
        foreach (var dir in Directory.GetDirectories(rawexd).OrderBy(d => d, StringComparer.OrdinalIgnoreCase))
        {
            string name = Path.GetFileName(dir);
            list.Add(new("exd/" + name.ToLowerInvariant(), name + "/（整個資料夾）", ExdNames.Describe(name + "/")));
        }
        foreach (var file in Directory.GetFiles(rawexd, "*.csv").OrderBy(f => f, StringComparer.OrdinalIgnoreCase))
        {
            string name = Path.GetFileNameWithoutExtension(file);
            list.Add(new("exd/" + name.ToLowerInvariant(), name, ExdNames.Describe(name)));
        }
        return list;
    }

    private bool MatchesSkipFilter(SkipEntry entry) =>
        _skipFilter.Length == 0 ||
        entry.Display.Contains(_skipFilter, StringComparison.OrdinalIgnoreCase) ||
        (entry.Desc?.Contains(_skipFilter, StringComparison.OrdinalIgnoreCase) ?? false);

    private void ToggleSkip(string key, bool on)
    {
        if (on) _skip.Add(key); else _skip.Remove(key);
    }

    private void Browse()
    {
        var path = PickFolder();
        if (path == null) return;
        if (PatchService.IsFFXIVFolder(path))
        {
            _gamePath = path;
            _message = null;
        }
        else
        {
            _message = "請選擇正確的遊戲根目錄，目錄預設名為：FINAL FANTASY XIV ONLINE";
        }
    }

    private void SaveConfig()
    {
        if (!PatchService.IsFFXIVFolder(_gamePath))
        {
            _message = "請選擇正確的遊戲根目錄，目錄預設名為：FINAL FANTASY XIV ONLINE";
            return;
        }
        Config.Set("GamePath", _gamePath);
        Config.Set("SLanguage", _sLang);
        Config.Set("DLanguage", Config.Get("DLanguage") ?? "CHS");
        Config.Set("FLanguage", "CSV");
        Config.Set("ReplaFont", _replaceFont ? "1" : "0");
        Config.Set("ReplaText", _replaceText ? "1" : "0");
        Config.Set("SkipFiles", string.Join("|", _skip.OrderBy(s => s, StringComparer.Ordinal)));
        Config.Set("TransMode", "0");
        Config.Save();
        _message = null;
        _showConfig = false;
    }

    private void CancelConfig()
    {
        LoadConfigForm();
        _message = null;
        _showConfig = false;
    }

    private void AskConfirm(string label, Func<Task> run)
    {
        _message = null;
        string note = label == "還原" ? "將把六個遊戲檔還原成漢化前的備份。" : "";
        _pending = (label, note, run);
    }

    private async Task ConfirmPending()
    {
        if (_pending is not { } p) return;
        _pending = null;
        await p.Run();
    }

    private async Task Patch()
    {
        await RunJob(p => Patcher.PatchAsync(p));
    }

    private async Task Rollback()
    {
        await RunJob(p => Patcher.RollbackAsync(p));
    }

    private async Task UpdateRawexd()
    {
        await RunJob(p => RawexdUpdater.UpdateAsync(p));
    }

    private async Task Lint()
    {
        _busy = true;
        _message = null;
        _percent = 0;
        _action = "正在檢查翻譯……";
        _detail = "";
        var progress = new Progress<PatchProgress>(p =>
        {
            _percent = p.Percent;
            _action = p.Action;
            _detail = p.Detail;
            InvokeAsync(StateHasChanged);
        });
        var result = await LintTool.RunAsync(progress);
        _busy = false;
        _isError = result.ErrorCount > 0;
        _message = result.Summary;
        StateHasChanged();
    }

    private async Task RunJob(Func<IProgress<PatchProgress>, Task<(bool Ok, string Message)>> job)
    {
        _busy = true;
        _message = null;
        _percent = 0;
        _action = "準備中……";
        _detail = "";
        var progress = new Progress<PatchProgress>(p =>
        {
            _percent = p.Percent;
            _action = p.Action;
            _detail = p.Detail;
            InvokeAsync(StateHasChanged);
        });
        var (ok, message) = await job(progress);
        _busy = false;
        _isError = !ok;
        _message = message;
        StateHasChanged();
    }
}
